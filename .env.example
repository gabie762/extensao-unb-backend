# Copie este arquivo para ".env" na mesma pasta e preencha os valores reais.
# O ".env" nunca deve ser commitado (ja esta no .gitignore).

# --- MongoDB ---
MONGO_USER=meu_nome
MONGO_PASSWORD=uma_senha_forte_aqui
MONGO_DATABASE=extensao_unb
MONGO_PORT=27017

# --- JWT ---
# Precisa ser longo (recomendado 256+ bits). Gere um novo para producao,
# nao reaproveite o de desenvolvimento.
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# --- Frontend ---
# URL publica onde o frontend fica acessivel. Usada para CORS e para montar
# o link de verificacao de e-mail (ex: FRONTEND_URL/verificar-email?token=...).
# Local com Caddy: http://localhost
# Producao: https://seu-dominio.com
FRONTEND_URL=http://localhost:3000

# --- Importacao de projetos (POST /projetos/importar) ---
# Endpoint publico protegido por chave (nao por login), usado por scripts
# externos para importar projetos em massa. Gere uma chave aleatoria, ex:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IMPORT_API_KEY=troque_por_uma_chave_aleatoria

# --- SMTP (envio de e-mail de verificacao) ---
# Estes dois valores abaixo (MAIL_HOST/MAIL_PORT) so sao usados se voce rodar
# o backend SEM Docker (./mvnw spring-boot:run) - nesse caso o Mailpit fica
# publicado em localhost:1025. Rodando via "docker compose up", o backend ja
# usa o nome do servico "mailpit" fixo (ver compose.yml), entao estes dois
# valores aqui sao ignorados nesse cenario.
# Caixa de entrada falsa do Mailpit: http://localhost:8025
# Para producao, use um SMTP real (ex: Gmail com senha de app) e mude
# MAIL_SMTP_AUTH para true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_FROM=no-reply@extensao-unb.local
